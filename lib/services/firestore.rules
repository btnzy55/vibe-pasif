rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Konfigurasi pabrik (Stok & Target)
    match /factory_config/{docId} {
      allow read: if true;
      allow write: if request.resource.data.stock >= 0;
    }
    
    // Log Hasil Produksi & QC
    match /production_logs/{logId} {
      allow read: if true;
      allow create: if request.resource.data.good >= 0 && request.resource.data.rej >= 0;
      allow update, delete: if true;
    }
    
    // Antrean Pesanan Klien
    match /clients/{clientId} {
      allow read: if true;
      allow create, update: if request.resource.data.qty >= 0;
      allow delete: if true;
    }
    
    // Inventaris Mesin & Riwayat Servis
    match /machines/{machineId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
  }
}
